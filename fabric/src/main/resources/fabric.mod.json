{
  "schemaVersion": 1,
  "id": "wildwoven",
  "version": "${version}",
  "name": "Wildwoven",
  "description": "A vanilla-oriented creature expansion focused on new mobs that naturally fit Minecraft.",
  "authors": ["Orrhisk"],
  "contact": {
    "sources": "https://github.com/NineteenReincarnation/Wildwoven",
    "issues": "https://github.com/NineteenReincarnation/Wildwoven/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.nineteenreincarnation.wildwoven.fabric.WildwovenFabric"],
    "client": ["io.github.nineteenreincarnation.wildwoven.fabric.WildwovenFabricClient"]
  },
  "mixins": [
    "wildwoven.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
